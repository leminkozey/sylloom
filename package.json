{
  "name": "sylloom",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local dictation, audio recording and structured meeting notes for macOS.",
  "bin": {
    "sylloom": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsx scripts/build.ts",
    "site": "tsx scripts/site.ts",
    "site:build": "tsx scripts/site.ts build",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "verify:local": "tsx scripts/verify-local.ts",
    "verify:dictation": "tsx scripts/verify-dictation.ts",
    "verify:formatting": "tsx scripts/verify-formatting.ts",
    "benchmark:dictation": "tsx scripts/benchmark-dictation.ts",
    "benchmark:runtime": "tsx scripts/benchmark-runtime.ts",
    "release:check": "tsx scripts/release.ts --check",
    "release:prepare": "tsx scripts/release.ts"
  },
  "dependencies": {
    "@studio-sadola/flexaudio": "0.7.0",
    "commander": "15.0.0",
    "ical.js": "^2.2.1",
    "koffi": "^3.3.3",
    "marked": "^18.1.1",
    "sanitize-html": "^2.18.1",
    "slice-ansi": "8.0.0",
    "string-width": "8.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/slice-ansi": "^5.0.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "files": [
    "dist/",
    "sylloom",
    "install.sh",
    "assets/",
    "LICENSE",
    "README.md",
    "DESIGN.md",
    "PERFORMANCE.md",
    "NOTICE.md"
  ],
  "homepage": "https://github.com/leminkozey/sylloom",
  "repository": {
    "type": "git",
    "url": "https://github.com/leminkozey/sylloom.git"
  }
}
